# =====================================================
# MinIO Authentication
# =====================================================
MINIO_ROOT_USER={{ minio_root_user }}
MINIO_ROOT_PASSWORD={{ minio_root_password }}

# =====================================================
# Protocol & Transport (EXPLICIT)
# =====================================================
{% if minio_tls_enabled | bool %}
MINIO_SCHEME=https
MINIO_ENABLE_HTTPS=true
{% else %}
MINIO_SCHEME=http
MINIO_ENABLE_HTTPS=false
{% endif %}

# =====================================================
# Public API Endpoint (SDKs, CLI, LB, clients)
# This MUST always be externally reachable
# =====================================================
MINIO_SERVER_URL={{ minio_scheme }}://{{ minio_server_fqdn }}:{{ minio_api_port }}

# =====================================================
# Console / Browser Redirect (DO NOT GUESS)
# Forces browser to the correct protocol + host
# =====================================================
MINIO_BROWSER_REDIRECT_URL={{ minio_scheme }}://{{ minio_server_fqdn }}:{{ minio_console_port }}

# =====================================================
# Console Binding Behavior
# Explicitly tell MinIO how to treat console traffic
# =====================================================
{% if minio_tls_enabled | bool %}
MINIO_CONSOLE_TLS_ENABLED=true
{% else %}
MINIO_CONSOLE_TLS_ENABLED=false
{% endif %}

# =====================================================
# Deployment Mode
# =====================================================
{% if minio_ha_enabled | bool %}
# Distributed / HA MinIO
MINIO_DISTRIBUTED_MODE_ENABLED=true
{% else %}
# Single-node MinIO
MINIO_DISTRIBUTED_MODE_ENABLED=false
{% endif %}

# =====================================================
# Observability / Metrics
# Metrics are exposed on: /minio/v2/metrics/cluster
# =====================================================
{% if minio_observability_enabled | bool %}
MINIO_PROMETHEUS_AUTH_TYPE={{ 'public' if minio_metrics_public | bool else 'jwt' }}
{% endif %}
