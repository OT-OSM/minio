# =====================================================
# MinIO Authentication (Root Admin)
# =====================================================
MINIO_ROOT_USER={{ minio_root_user }}
MINIO_ROOT_PASSWORD={{ minio_root_password }}

# =====================================================
# Protocol & Transport
# =====================================================
{% if minio_tls_enabled | bool %}
MINIO_SCHEME=https
MINIO_ENABLE_HTTPS=true
{% else %}
MINIO_SCHEME=http
MINIO_ENABLE_HTTPS=false
{% endif %}

# =====================================================
# Public API Endpoint- DO NOT set MINIO_SERVER_URL for single-node
# - mc admin must always use localhost
# =====================================================
{% if minio_ha_enabled | bool %}
MINIO_SERVER_URL={{ minio_scheme }}://{{ minio_server_fqdn }}:{{ minio_api_port }}
{% endif %}

# =====================================================
# Console / Browser Redirect (CRITICAL: PORT MUST BE PRESENT)
# =====================================================
{% if minio_dns_enabled | bool %}
MINIO_BROWSER_REDIRECT_URL={{ minio_scheme }}://{{ minio_dns_name }}:{{ minio_console_port }}
{% else %}
MINIO_BROWSER_REDIRECT_URL={{ minio_scheme }}://{{ minio_server_fqdn }}:{{ minio_console_port }}
{% endif %}

# =====================================================
# Console TLS behavior
# =====================================================
{% if minio_tls_enabled | bool %}
MINIO_CONSOLE_TLS_ENABLED=true
{% else %}
MINIO_CONSOLE_TLS_ENABLED=false
{% endif %}

# =====================================================
# Deployment Mode
# =====================================================
{% if minio_ha_enabled | bool %}
MINIO_DISTRIBUTED_MODE_ENABLED=true
{% else %}
MINIO_DISTRIBUTED_MODE_ENABLED=false
{% endif %}

# =====================================================
# Observability / Metrics
# =====================================================
{% if minio_observability_enabled | bool %}
MINIO_PROMETHEUS_AUTH_TYPE={{ 'public' if minio_metrics_public | bool else 'jwt' }}
{% endif %}

# =====================================================
# OIDC / SSO (SAFE, OPTIONAL, FUTURE-READY)
# =====================================================
{% if minio_tls_enabled | bool and minio_oidc_enabled | bool %}
MINIO_IDENTITY_OPENID_CONFIG_URL={{ minio_oidc_config_url }}
MINIO_IDENTITY_OPENID_CLIENT_ID={{ minio_oidc_client_id }}
MINIO_IDENTITY_OPENID_CLIENT_SECRET={{ minio_oidc_client_secret }}
MINIO_IDENTITY_OPENID_SCOPES={{ minio_oidc_scopes }}
MINIO_IDENTITY_OPENID_CLAIM_NAME={{ minio_oidc_claim_name }}
MINIO_IDENTITY_OPENID_DISPLAY_NAME={{ minio_oidc_display_name }}
MINIO_IDENTITY_OPENID_REDIRECT_URI={{ minio_scheme }}://{{ minio_server_fqdn }}:{{ minio_console_port }}/oauth_callback
{% endif %}
