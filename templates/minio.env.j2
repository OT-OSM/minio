# =====================================================
# MinIO Authentication
# =====================================================
MINIO_ROOT_USER={{ minio_root_user }}
MINIO_ROOT_PASSWORD={{ minio_root_password }}

# =====================================================
# Network & Endpoint Identity
# =====================================================

{% if minio_tls_enabled | bool %}
MINIO_SCHEME=https
{% else %}
MINIO_SCHEME=http
{% endif %}

# Public endpoint used by clients (SDK / browser / LB)
MINIO_SERVER_URL={{ minio_scheme }}://{{ minio_server_fqdn }}:{{ minio_api_port }}

# Console access (admin UI)
MINIO_BROWSER_REDIRECT_URL={{ minio_scheme }}://{{ minio_server_fqdn }}:{{ minio_console_port }}

# =====================================================
# Deployment Mode
# =====================================================
{% if minio_ha_enabled | bool %}
# Distributed / HA MinIO
MINIO_DISTRIBUTED_MODE_ENABLED=true
{% else %}
# Single-node MinIO
MINIO_DISTRIBUTED_MODE_ENABLED=false
{% endif %}

# =====================================================
# Observability
# =====================================================
{% if minio_observability_enabled | bool %}
MINIO_PROMETHEUS_AUTH_TYPE=public
{% endif %}
